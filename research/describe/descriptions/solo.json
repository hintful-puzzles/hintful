{
  "$schema": "../../../src/describe/description.schema.json",
  "game": "solo",
  "name": "Solo",
  "family": "latin",
  "note": "A block is c rows tall and r columns wide, as the game's rectangularBlocks builds it; the sizes are the game's c and r.",
  "sizes": { "c": { "min": 2, "max": 5 }, "r": { "min": 1, "max": 5 } },
  "space": {
    "grid": { "w": "c * r", "h": "c * r" },
    "regions": { "box": "blocks(r, c)" },
    "units": ["rows", "cols", "box"]
  },
  "answer": { "value": { "sort": "cell", "domain": "range(1, c * r)" } },
  "given": ["value"],
  "marks": { "cand": { "sort": "cell", "notation": "set of range(1, c * r)" } },
  "shape": ["latin(value, units)"],
  "freedom": { "kind": "fill" },
  "deal": { "symmetry": "of the givens", "tier": "one of the tiers" },
  "variations": {
    "Jigsaw": {
      "word": "board shape",
      "note": "The game deals a jigsaw board at r = 1.",
      "replace": { "space": { "regions": { "box": "dealt" } } }
    },
    "X": {
      "word": "modifier",
      "replace": { "space": { "diagonals": true } },
      "add": {
        "rules": {
          "diagonals": "forall L in diagonals: distinct(value(c) over c in cells(L))"
        }
      }
    },
    "Killer": {
      "word": "modifier",
      "replace": { "space": { "regions": { "cage": "dealt" } } },
      "add": {
        "clues": {
          "cage": {
            "at": "region",
            "value": "range(1, 45)",
            "means": "sum(c in cells(at) of value(c)) = v and distinct(value(c) over c in cells(at))"
          }
        }
      }
    }
  }
}
