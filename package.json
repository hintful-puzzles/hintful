{
  "name": "hintful",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/describe.ts --quiet",
    "build": "npm run -s tsc && vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "tsc": "node node_modules/typescript-7/bin/tsc",
    "pretypecheck": "node scripts/describe.ts --quiet",
    "typecheck": "npm run -s tsc -- -b --noEmit && npm run -s tsc -- --noEmit -p tsconfig.node.json",
    "pretest": "sh scripts/reap-orphaned-workers.sh",
    "test": "vitest",
    "pretest:run": "sh scripts/reap-orphaned-workers.sh",
    "test:run": "vitest run --passWithNoTests",
    "diff": "vitest run --passWithNoTests -c scripts/checks/diff.vitest.config.mts",
    "gate": "sh scripts/gate.sh",
    "fast-checks": "GATE_KEEP_GOING=1 sh scripts/gate.sh",
    "test:hint-sweeps": "vitest run src/guards/hint-text-convention.test.ts src/guards/hint-quality.test.ts src/guards/hint-walk-fingerprint.test.ts src/engine/solve/hint-frontier.test.ts src/guards/ladder-continuity.test.ts src/guards/hint-resume.test.ts",
    "test:research-guards": "vitest run -c research/vitest.guards.config.ts",
    "test:slow": "PUZZLES_SLOW_TESTS=1 vitest run --passWithNoTests",
    "test:shuffle": "vitest run --passWithNoTests --sequence.shuffle.files=true",
    "prepare": "husky && node scripts/describe.ts --quiet",
    "premetrics": "node scripts/describe.ts --quiet",
    "metrics": "sh scripts/metrics.sh",
    "mutation": "rm -rf .stryker-tmp && stryker run scripts/stryker.config.mjs",
    "probe": "node scripts/feedback-probe.mjs",
    "prerefs": "node scripts/describe.ts --quiet",
    "refs": "node scripts/refs.mjs",
    "preagent-diagnostics": "node scripts/describe.ts --quiet",
    "agent-diagnostics": "sh scripts/agent-diagnostics.sh",
    "pregame": "node scripts/describe.ts --quiet",
    "game": "node scripts/game.ts",
    "game-id": "node scripts/game-id.ts",
    "prehint-scan": "node scripts/describe.ts --quiet",
    "hint-scan": "node scripts/hint-scan.ts",
    "predeal-walk": "node scripts/describe.ts --quiet",
    "deal-walk": "node scripts/deal-walk.ts",
    "compare-cost": "node scripts/compare-cost.ts",
    "describe": "node scripts/describe.ts",
    "predead-exports": "node scripts/describe.ts --quiet",
    "dead-exports": "node scripts/checks/unused-exports.mjs",
    "absence": "node scripts/checks/absence-spelling.mjs"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.5.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lit-labs/observers": "^2.1.0",
    "@lit-labs/signals": "^0.3.0",
    "@lit/context": "^1.1.6",
    "@material-design-icons/svg": "^0.14.15",
    "@sentry/browser": "^10.49.0",
    "colorjs.io": "^0.7.1",
    "comlink": "^4.4.2",
    "dexie": "^4.4.2",
    "lit": "^3.3.2",
    "lucide-static": "^1.8.0",
    "signal-utils": "^0.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.12",
    "@fission-ai/openspec": "2.0.0",
    "@lit/reactive-element": "^2.1.2",
    "@mdit/plugin-attrs": "^1.1.1",
    "@mdit/plugin-icon": "^1.0.2",
    "@sentry/vite-plugin": "^5.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "handlebars": "^4.7.10",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "madge": "^8.0.0",
    "markdown-it": "^14.3.3",
    "markdown-it-anchor": "^9.2.0",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tinyglobby": "^0.2.17",
    "typescript": "~5.9.0",
    "typescript-7": "npm:typescript@~7.0",
    "vite": "^8.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^5.0.5",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-window": "^7.3.0",
    "yaml": "^2.9.1",
    "z3-solver": "^5.3.3"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.9",
    "glob@>=11 <14": "^14.0.3",
    "minimatch@>=7 <11.0.1": "^11.0.1",
    "qs": "^6.16.1",
    "serialize-javascript": "^7.1.3",
    "sharp": "^0.35.5"
  }
}
