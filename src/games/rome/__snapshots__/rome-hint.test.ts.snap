exports[`rome: pinned hint positions > says, at each pin 1`] = `
{
  "clean": "Now clear the easy ones: cross out any arrow already placed in its square's area.",
  "dup": "This area now has its up arrow, so the up mark in it must go.",
  "hiddenSingle": "Its area must hold all four arrows, and only this square can still point right, so it must point right.",
  "loop": "The arrow in the square above points back to this square, so this square can only point left or right.",
  "note": "Of the ways this square can point, only up and right aren't already used in its area, so pencil them in.",
  "opensOnLoop": "The arrow in the square below points back to this square, so this square's down mark must go.",
  "opposite": "Its left neighbor in this area must point right (a loop) or left (two lefts), so this square must point right.",
  "pair": "Two squares of this area must take left or right between them, so the left mark of the area must go.",
  "populate": "Start by penciling every candidate arrow into each empty square.",
  "reach": "Every square needs a goal, and only one mark in this square leads to the striped group, so its other marks must go.",
  "regionsFull": "Every other way this square can point is already used in its area, so it must point left.",
  "single": "Every other arrow has been ruled out in this square, so it can only point down.",
}
`;
