exports[`map: pinned hint positions > says, at each pin 1`] = `
{
  "clean": "Now clear the easy ones: remove from each blank region the dot of every color a neighbor already shows.",
  "deadDots": "This region's other dots match its neighbors' colors, so it must be violet.",
  "fill": "Start by dotting all four colors into each blank region, so there is something to cross out.",
  "onlyColorLeft": "This region touches pink, teal and violet, so it must be yellow.",
  "pairDot": "This region's neighbors show pink and violet, so it can only be yellow or teal: dot those.",
  "pairMark": "This region touches the outlined pair, which use both pink and yellow, so it can't be either: dot teal and violet.",
  "pairPlace": "This region touches the outlined pair, which use both yellow and teal, so it can't be either and must be violet.",
  "sharedPair": "This region's neighbors show pink and violet, so it can only be yellow or teal: dot those.",
  "touches": "This region touches pink, teal and violet, so it must be yellow.",
  "weighDot": "This region's neighbors show teal and violet, so it can only be pink or yellow: dot those.",
  "weighEnds": "Whatever goes in the middle region, an outlined region by this region must have violet, so it can't be violet: dot pink and yellow.",
  "weighMark": "Whatever goes in the middle region, an outlined region by this region must have violet, so it can't be violet: dot pink and yellow.",
  "weighPlace": "Whatever goes in the middle region, an outlined region by this region must have yellow, so it can't be yellow and must be teal.",
  "weighRegion": "This region's neighbors show teal and violet, so it can only be pink or yellow: dot those.",
  "weighSelf": "Whatever goes in the middle region, it or an outlined region by this region must have violet, so it can't be violet: dot pink and yellow.",
  "weighStrike": "Whatever goes in the middle region, an outlined region by this region must have violet, so it can't be violet: its violet dot must go.",
}
`;
