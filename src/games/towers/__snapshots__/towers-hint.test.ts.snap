exports[`towers: pinned hint positions > says, at each pin 1`] = `
{
  "arrangement": "No way for clue 3 to show exactly 3 towers along its line puts height 2 in this cell, so the 2 must go.",
  "clean": "Now clear the easy ones: cross out any height already standing in its cell's row or column.",
  "dup": "The 2 just placed can't repeat in its row and column, so the 2 must go from the other cells.",
  "facing": "These facing clues sum to one more than the grid size, so their line's tallest is pinned: this cell must be 5.",
  "fullLine": "Clue 5 sees every tower in this line, so heights must climb 1, 2, … from the clue: this cell must be 1.",
  "hiddenSingle": "No other cell in this row can be height 5, so this cell must be 5.",
  "lineFull": "Clue 2 already sees 1 tower in the line, so the cell nearest it must top all between; height 1 can't, so this cell can only be 2, 3 or 4.",
  "lowerBound": "Clue 2 sees exactly 2 towers along its line; height 5 so near it would hide too many, so this cell can only be 1, 2, 3 or 4.",
  "note": "No height is standing in this cell's row or column yet, so every one must be penciled in.",
  "populate": "Start by penciling every candidate height into each empty cell.",
  "regionsFull": "This cell's row and column already hold every other height, so it can only be 5.",
  "set": "These 2 columns fit 5 only in the outlined cells, taking both rows' 5, so the 5 must go.",
  "single": "Every other height has been ruled out in this cell, so it can only be 4.",
  "tallestNearest": "Clue 1 sees one tower in its line, so the tallest must stand next to it: this cell must be 5.",
  "wing": "Whatever goes in the middle cell, another outlined cell in line with this cell must have 1, so this cell must be 3.",
}
`;

exports[`towers: pinned hint positions > says, at each pin 2`] = `
{
  "lowerBound": "Clue 4 sees exactly 4 towers along its line; height 4 so near it would hide too many, so the 4 must go.",
  "multiMarkStrike": "Now clear the easy ones: cross out any height already standing in its cell's row or column.",
  "placement": "Clue 5 sees every tower in this line, so heights must climb 1, 2, … from the clue: this cell must be 1.",
  "strike": "Now clear the easy ones: cross out any height already standing in its cell's row or column.",
}
`;
