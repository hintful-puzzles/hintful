exports[`net: pinned hint positions > says, at each pin 1`] = `
{
  "fitLock": "This straight must fit the wall, so only one way fits: turn it.",
  "fitNote": "The outlined corner must fit the outlined lock, so it can never point right: note no wire across this side.",
  "loopLock": "Pointing right and down, this corner would close a loop through the striped squares, so only one way fits the outlined note and lock: turn it.",
  "loopNote": "Pointing right, down and left, the outlined T would close a loop through the striped squares, so it must point up: note a wire across this side.",
  "sealLock": "Pointing any other way, this dead end would seal off some striped squares (one across the wrapped edge), so only one way fits: turn it.",
  "sealNote": "Pointing right, the outlined dead end would face the striped dead end, so it can never point right: note no wire across this side.",
  "strandLock": "Pointing up, down and left, this T would leave the outlined straight no way to fit it without closing a loop through the striped squares, so only one way fits the outlined locks: turn it.",
  "turn": "This straight must fit the wall, so only one way fits: turn it.",
}
`;

