exports[`clusters: pinned hint positions > says, at each pin 1`] = `
{
  "countFull.more": "The outlined dotted disc must touch three more blocks, and the outlined dotted block allows at most one block beside it, so this square, beside only the dotted disc, must hold a block.",
  "countFull.same": "The outlined dotted disc must touch one more block, and the outlined dotted block allows at most one block beside it, so this square, beside only the dotted block, must hold a disc.",
  "countShort.more": "The outlined disc must touch two more discs, and the outlined dotted block allows at most one disc beside it, so this square, beside only the disc, must hold a disc.",
  "refute.dotOvercount": "The outlined dotted disc beside this square already touches its one disc, so this square must hold a block.",
  "refute.nearReach": "If this square held a disc, its outlined block neighbor couldn't touch two blocks, so this square must hold a block.",
  "refute.nearSurrounded": "A block in this square would seal its outlined disc neighbor off from other discs, so this square must hold a disc.",
  "refute.selfReach": "If this square held a block, at most one neighbor could ever match it, but it needs two, so it must hold a disc.",
  "refute.selfSurrounded": "Every neighbor of this square holds a disc. Holding a block, it could never touch another block, so it must hold a disc.",
}
`;

