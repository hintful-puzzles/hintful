exports[`keen: pinned hint positions > says, at each pin 1`] = `
{
  "cage": "No way to make this cage sum to 7 puts 1 or 2 in this cell, so this cell can only be 3 or 4.",
  "cageLine": "This cage must multiply to 10, and every way to fill it places a 1 in its row, so 1 and 2 must go.",
  "clean": "Now clear the easy ones: cross out any number already standing in its cell's row or column.",
  "dup": "The 3 just placed can't repeat in its row and column, so the 3 must go from the other cells.",
  "hiddenSingle": "Every other cell in this column rules out 3, so this cell must be 3.",
  "note": "Nothing in this cell's row or column rules out a number yet, so pencil in every one.",
  "populate": "Start by penciling every candidate number into each empty cell, so there is something to cross out.",
  "regionsFull": "This cell's row and column already hold every other number, so it can only be 2.",
  "set": "These 3 columns fit 5 only in the outlined cells, taking the 5 of 3 rows, so this cell can only be 1, 2, 3, 4 or 6.",
  "single": "Every other number has been ruled out in this cell, so it can only be 5.",
  "wing": "Whatever goes in the middle cell, another outlined cell in line with this cell must have 2, so this cell can only be 1, 3 or 4.",
}
`;

exports[`keen: pinned hint positions > says, at each pin 2`] = `
{
  "hiddenSingle": "Every other cell in this row rules out 5, so this cell must be 5.",
  "hiddenSingleSmall": "Every other cell in this row rules out 2, so this cell must be 2.",
