exports[`boats: pinned hint positions > says, at each pin 1`] = `
{
  "allWaterPlaced": "Every square of water the puzzle has room for is already marked, so every free square (ringed) must hold a boat segment.",
  "centerCount": "This row has no room for a boat running across through this middle segment, so the square to its right must be water.",
  "centerForced": "This middle segment has outlined water beside it, so its boat must fill the squares above and below, with its water.",
  "givenClue": "This segment is a boat's top end, so its boat must continue into the square below it, with its water.",
  "growTooLong": "Filling this square joins the outlined segments into a boat of 4; the largest still missing is 3, so it must be water.",
  "isolated": "Every 1-boat is already placed, and water or the board's edge surrounds this square, so it must be water.",
  "lineForced": "This row needs 3 more boat squares and has 3 free squares (ringed), so each must hold a boat segment, with its water.",
  "lineSatisfied": "This column's number is 0, so every square in it must be water.",
  "lineSatisfiedOfSeveral": "This column's number is 0, so every square in it must be water.",
  "mustExtend": "Every 1-boat is placed and this segment is shut in on three sides, so its boat must use the ringed fourth, with its water.",
  "mustGrow": "Every 2-boat is already placed, so this unfinished boat can't stop at 2: it must continue into this square.",
  "neverTouch": "Boats never touch, not even at a corner, so the ringed squares diagonally beside this segment must be water.",
  "onlyRunsLeft": "Only the outlined run can hold the 4-boat, so the ringed square is covered wherever it sits.",
  "refuted": "If this square were water, it would make one boat (outlined) too many, so it must hold a boat segment.",
  "runTooShort": "Filling this run would make a boat of 2, but every 2-boat is already placed, so its free square must be water.",
  "sharedDiagonal": "This column can take 1 more water, so one outlined square must be a boat: the middle one's ringed sides must be water.",
}
`;

exports[`boats: pinned hint positions > says, at each pin 2`] = `
{
  "evidence": "This segment is a boat's top end, so its boat must continue into the square below it, with its water.",
}
`;
